FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     postProcess;

functions
{
    numpyImport
    {
        type                numpyToFoam;
        libs                (numpyFunctionObjects);

        inputDir            "postProcessing/numpyExport";
        segment             "0.1";
        fields              (p U);
        templateInstance    "0";
        writeFields         true;

        executeControl      timeStep;
        writeControl        timeStep;
    }
}

// ************************************************************************* //
