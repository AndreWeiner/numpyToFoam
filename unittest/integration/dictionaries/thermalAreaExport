FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermalAreaExport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

functions
{
    thermalAreaExport
    {
        type            finiteAreaToNumpy;
        libs            (numpyFunctionObjects regionFaModels);
        area            region0;
        areaFields      (Ts hs);
        edgeFields      ();
        outputDir       "postProcessing/thermalAreaExport";
        batchSize       1;
        writeAreaCentres true;
        writeControl    timeStep;
    }
}
