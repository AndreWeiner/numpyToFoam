FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      compressibleNativeForces;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

functions
{
    nativeForces
    {
        type            forces;
        libs            (forces);
        patches         (walls);
        p               p;
        U               U;
        rho             rho;
        CofR            (0 0 0);
        writeFields     true;
        writeControl    timeStep;
    }
}
