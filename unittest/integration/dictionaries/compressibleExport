FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      compressibleExport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

functions
{
    compressibleExport
    {
        type            foamToNumpy;
        libs            (numpyFunctionObjects);
        fields          (p U rho T k epsilon);
        outputDir       "postProcessing/compressibleExport";
        batchSize       2;
        writeControl    timeStep;
    }
}
